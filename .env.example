# Backend security and browser access
EDUSYNC_JWT_SECRET=replace-with-a-long-random-value
EDUSYNC_CORS_ORIGINS=http://localhost:8081
EDUSYNC_CREATE_TEST_ACCOUNTS=1

# Local Llama 3 GGUF (the file is ignored by Git)
EDUSYNC_MODEL_PATH=backend/models/Meta-Llama-3-8B-Instruct-Q4_K_M.gguf
EDUSYNC_GPU_LAYERS=-1
EDUSYNC_N_THREADS=8
EDUSYNC_N_BATCH=256
EDUSYNC_N_CTX=2048
EDUSYNC_USE_MLOCK=0

# Expo: replace with the Mac's Wi-Fi IP before starting Expo Go
EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
